# Telegram Bot Configuration
# ==========================
# 1. Создай бота: напиши @BotFather в Telegram → /newbot
# 2. Скопируй токен сюда:
TELEGRAM_BOT_TOKEN=your_token_here

# 3. Узнай свой chat_id: напиши @userinfobot в Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Интервал проверки сайтов (в секундах, по умолчанию 300 = 5 мин)
CHECK_INTERVAL=300
